# Renders labelled placeholder boxes in place of photography.
#
# The site references 81 generated images under public/images/ that have not
# been produced yet. While this is set to 1, ImageSlot renders a sized,
# labelled box instead of next/image, so the site builds and reviews cleanly
# without them, and the asset assertion in the content conformance suite is
# skipped.
#
# Set this to 0 (or delete this file) once the images exist. The conformance
# suite will then fail loudly listing anything still missing, which is the
# checklist for finishing the job.
NEXT_PUBLIC_HOLYLOY_IMAGES_PENDING=1
